<?xml version="1.0" encoding="utf-8"?>
<!-- The playing notification, folded (64dp). The whole cover shows: it's fitted, not cropped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/n_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent.Title" />

        <TextView
            android:id="@+id/n_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/n_prev"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="11dp"
        android:scaleType="centerInside" />

    <ImageButton
        android:id="@+id/n_play"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="10dp"
        android:scaleType="centerInside" />

    <ImageButton
        android:id="@+id/n_next"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="11dp"
        android:scaleType="centerInside" />

    <!-- Top right: stop, close Grapefruit and clear the notification. -->
    <ImageButton
        android:id="@+id/n_close"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="10dp"
        android:scaleType="centerInside" />
</LinearLayout>
