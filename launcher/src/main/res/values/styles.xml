<resources>
    <color name="icon_background">#1C0A0E</color>
    <style name="LauncherTheme" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">#1C0A0E</item>
        <item name="android:colorBackground">#1C0A0E</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LauncherDialogWindow" parent="android:Theme.Holo.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
