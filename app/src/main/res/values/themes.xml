<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grapefruit.Light" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="android:textColorHighlight">#66F2545B</item>
        <item name="gfBackground">@color/light_background</item>
        <item name="gfGroupedBackground">@color/light_grouped</item>
        <item name="gfSurface">@color/light_surface</item>
        <item name="gfBar">@color/light_bar</item>
        <item name="gfTextPrimary">@color/light_text</item>
        <item name="gfTextSecondary">@color/light_text_secondary</item>
        <item name="gfSeparator">@color/light_separator</item>
        <item name="gfAccent">@color/grapefruit</item>
        <item name="gfFill">@color/light_fill</item>
        <item name="gfScrim">@color/light_scrim</item>
        <item name="gfRowBackground">@drawable/row_light</item>
        <item name="gfFieldBackground">@drawable/field_light</item>
        <item name="gfPillBackground">@drawable/pill_light</item>
        <item name="gfControl">@color/light_control</item>
        <item name="gfControlPressed">@color/light_control_pressed</item>
        <item name="gfToggleOff">@color/light_toggle_off</item>
        <item name="gfToggleOffSegments">@color/light_toggle_off_segments</item>
        <item name="gfKnob">@color/light_knob</item>
        <!-- Grapefruit's own look for platform widgets, the same on every Android version. -->
        <item name="android:editTextStyle">@style/GrapefruitEditText.Light</item>
        <item name="android:textSelectHandle">@drawable/handle_middle</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/handle_right</item>
        <item name="android:listViewStyle">@style/GrapefruitListView.Light</item>
        <item name="android:gridViewStyle">@style/GrapefruitGridView.Light</item>
        <item name="android:scrollViewStyle">@style/GrapefruitScrollView.Light</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarSize">4dp</item>
    </style>

    <style name="Theme.Grapefruit.Dark" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:textColorHighlight">#66FF6B6B</item>
        <item name="gfBackground">@color/dark_background</item>
        <item name="gfGroupedBackground">@color/dark_grouped</item>
        <item name="gfSurface">@color/dark_surface</item>
        <item name="gfBar">@color/dark_bar</item>
        <item name="gfTextPrimary">@color/dark_text</item>
        <item name="gfTextSecondary">@color/dark_text_secondary</item>
        <item name="gfSeparator">@color/dark_separator</item>
        <item name="gfAccent">@color/grapefruit_bright</item>
        <item name="gfFill">@color/dark_fill</item>
        <item name="gfScrim">@color/dark_scrim</item>
        <item name="gfRowBackground">@drawable/row_dark</item>
        <item name="gfFieldBackground">@drawable/field_dark</item>
        <item name="gfPillBackground">@drawable/pill_dark</item>
        <item name="gfControl">@color/dark_control</item>
        <item name="gfControlPressed">@color/dark_control_pressed</item>
        <item name="gfToggleOff">@color/dark_toggle_off</item>
        <item name="gfToggleOffSegments">@color/dark_toggle_off_segments</item>
        <item name="gfKnob">@color/dark_knob</item>
        <!-- Grapefruit's own look for platform widgets, the same on every Android version. -->
        <item name="android:editTextStyle">@style/GrapefruitEditText.Dark</item>
        <item name="android:textSelectHandle">@drawable/handle_middle</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/handle_right</item>
        <item name="android:listViewStyle">@style/GrapefruitListView.Dark</item>
        <item name="android:gridViewStyle">@style/GrapefruitGridView.Dark</item>
        <item name="android:scrollViewStyle">@style/GrapefruitScrollView.Dark</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarSize">4dp</item>
    </style>

    <!-- Grapefruit Light: on the lighter side, in the app icon's colours instead of white. -->
    <style name="Theme.Grapefruit.GrapefruitLight" parent="Theme.Grapefruit.Light">
        <item name="android:windowBackground">@color/grapefruit_light_background</item>
        <item name="android:colorBackground">@color/grapefruit_light_background</item>
        <item name="android:textColorHighlight">#66E83850</item>
        <item name="gfBackground">@color/grapefruit_light_background</item>
        <item name="gfGroupedBackground">@color/grapefruit_light_grouped</item>
        <item name="gfSurface">@color/grapefruit_light_surface</item>
        <item name="gfBar">@color/grapefruit_light_bar</item>
        <item name="gfTextPrimary">@color/grapefruit_light_text</item>
        <item name="gfTextSecondary">@color/grapefruit_light_text_secondary</item>
        <item name="gfSeparator">@color/grapefruit_light_separator</item>
        <item name="gfAccent">@color/grapefruit_light_accent</item>
        <item name="gfFill">@color/grapefruit_light_fill</item>
        <item name="gfScrim">@color/grapefruit_light_scrim</item>
        <item name="gfRowBackground">@drawable/row_grapefruit_light</item>
        <item name="gfFieldBackground">@drawable/field_grapefruit_light</item>
        <item name="gfPillBackground">@drawable/pill_grapefruit_light</item>
        <item name="gfControl">@color/grapefruit_light_control</item>
        <item name="gfControlPressed">@color/grapefruit_light_control_pressed</item>
        <item name="gfToggleOff">@color/grapefruit_light_toggle_off</item>
        <item name="gfToggleOffSegments">@color/grapefruit_light_toggle_off_segments</item>
        <item name="gfKnob">@color/grapefruit_light_knob</item>
        <item name="android:editTextStyle">@style/GrapefruitEditText.GrapefruitLight</item>
    </style>

    <!-- Grapefruit Dark: the same colours after dark, instead of black. -->
    <style name="Theme.Grapefruit.GrapefruitDark" parent="Theme.Grapefruit.Dark">
        <item name="android:windowBackground">@color/grapefruit_dark_background</item>
        <item name="android:colorBackground">@color/grapefruit_dark_background</item>
        <item name="android:textColorHighlight">#66FF7F6B</item>
        <item name="gfBackground">@color/grapefruit_dark_background</item>
        <item name="gfGroupedBackground">@color/grapefruit_dark_grouped</item>
        <item name="gfSurface">@color/grapefruit_dark_surface</item>
        <item name="gfBar">@color/grapefruit_dark_bar</item>
        <item name="gfTextPrimary">@color/grapefruit_dark_text</item>
        <item name="gfTextSecondary">@color/grapefruit_dark_text_secondary</item>
        <item name="gfSeparator">@color/grapefruit_dark_separator</item>
        <item name="gfAccent">@color/grapefruit_dark_accent</item>
        <item name="gfFill">@color/grapefruit_dark_fill</item>
        <item name="gfScrim">@color/grapefruit_dark_scrim</item>
        <item name="gfRowBackground">@drawable/row_grapefruit_dark</item>
        <item name="gfFieldBackground">@drawable/field_grapefruit_dark</item>
        <item name="gfPillBackground">@drawable/pill_grapefruit_dark</item>
        <item name="gfControl">@color/grapefruit_dark_control</item>
        <item name="gfControlPressed">@color/grapefruit_dark_control_pressed</item>
        <item name="gfToggleOff">@color/grapefruit_dark_toggle_off</item>
        <item name="gfToggleOffSegments">@color/grapefruit_dark_toggle_off_segments</item>
        <item name="gfKnob">@color/grapefruit_dark_knob</item>
        <item name="android:editTextStyle">@style/GrapefruitEditText.GrapefruitDark</item>
    </style>

    <!-- Text fields: rounded fill, grapefruit cursor. -->
    <style name="GrapefruitEditText.Light" parent="android:Widget.Holo.Light.EditText">
        <item name="android:background">@drawable/field_light</item>
        <item name="android:textCursorDrawable">@drawable/cursor_light</item>
        <item name="android:textColor">@color/light_text</item>
        <item name="android:textColorHint">@color/light_text_secondary</item>
    </style>

    <style name="GrapefruitEditText.GrapefruitLight" parent="android:Widget.Holo.Light.EditText">
        <item name="android:background">@drawable/field_grapefruit_light</item>
        <item name="android:textCursorDrawable">@drawable/cursor_grapefruit_light</item>
        <item name="android:textColor">@color/grapefruit_light_text</item>
        <item name="android:textColorHint">@color/grapefruit_light_text_secondary</item>
    </style>

    <style name="GrapefruitEditText.GrapefruitDark" parent="android:Widget.Holo.EditText">
        <item name="android:background">@drawable/field_grapefruit_dark</item>
        <item name="android:textCursorDrawable">@drawable/cursor_grapefruit_dark</item>
        <item name="android:textColor">@color/grapefruit_dark_text</item>
        <item name="android:textColorHint">@color/grapefruit_dark_text_secondary</item>
    </style>

    <style name="GrapefruitEditText.Dark" parent="android:Widget.Holo.EditText">
        <item name="android:background">@drawable/field_dark</item>
        <item name="android:textCursorDrawable">@drawable/cursor_dark</item>
        <item name="android:textColor">@color/dark_text</item>
        <item name="android:textColorHint">@color/dark_text_secondary</item>
    </style>

    <!-- No overscroll glow (blue on Android 4, tinted on 5+). -->
    <style name="GrapefruitListView.Light" parent="android:Widget.Holo.Light.ListView">
        <item name="android:overScrollMode">never</item>
        <item name="android:listSelector">@android:color/transparent</item>
    </style>

    <style name="GrapefruitListView.Dark" parent="android:Widget.Holo.ListView">
        <item name="android:overScrollMode">never</item>
        <item name="android:listSelector">@android:color/transparent</item>
    </style>

    <style name="GrapefruitGridView.Light" parent="android:Widget.Holo.Light.GridView">
        <item name="android:overScrollMode">never</item>
        <item name="android:listSelector">@drawable/grid_selector</item>
        <item name="android:drawSelectorOnTop">true</item>
    </style>

    <style name="GrapefruitGridView.Dark" parent="android:Widget.Holo.GridView">
        <item name="android:overScrollMode">never</item>
        <item name="android:listSelector">@drawable/grid_selector</item>
        <item name="android:drawSelectorOnTop">true</item>
    </style>

    <style name="GrapefruitScrollView.Light" parent="android:Widget.Holo.Light.ScrollView">
        <item name="android:overScrollMode">never</item>
    </style>

    <style name="GrapefruitScrollView.Dark" parent="android:Widget.Holo.ScrollView">
        <item name="android:overScrollMode">never</item>
    </style>

    <!--
        Window for GrapefruitDialog. Applied on top of the activity's theme, so it only sets up
        the window; the dialog draws its own card or sheet.
    -->
    <style name="GrapefruitDialogWindow">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@style/GrapefruitCardAnimation</item>
    </style>

    <style name="GrapefruitCardAnimation">
        <item name="android:windowEnterAnimation">@anim/card_in</item>
        <item name="android:windowExitAnimation">@anim/card_out</item>
    </style>

    <style name="GrapefruitSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
