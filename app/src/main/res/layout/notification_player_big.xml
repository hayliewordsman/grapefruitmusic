<?xml version="1.0" encoding="utf-8"?>
<!-- The playing notification, unfolded (128dp): the whole cover, the song, the controls. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp">

    <ImageView
        android:id="@+id/n_art"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_alignParentLeft="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Top right: stop, close Grapefruit and clear the notification. -->
    <ImageButton
        android:id="@+id/n_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@null"
        android:padding="12dp"
        android:scaleType="centerInside" />

    <LinearLayout
        android:id="@+id/n_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/n_close"
        android:layout_toRightOf="@id/n_art"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent.Title" />

        <TextView
            android:id="@+id/n_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent" />

        <TextView
            android:id="@+id/n_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_toRightOf="@id/n_art"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/n_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@null"
            android:padding="13dp"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/n_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@null"
            android:padding="11dp"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/n_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@null"
            android:padding="13dp"
            android:scaleType="centerInside" />
    </LinearLayout>
</RelativeLayout>
