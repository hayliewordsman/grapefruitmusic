<resources>
    <style name="FastBase" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_dark</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="FastTheme" parent="FastBase"/>
    <!-- Android 13+ is told which of these to start with next time, to match the chosen theme. -->
    <style name="FastSplash.Dark" parent="android:Theme.Holo.NoActionBar"/>
    <style name="FastSplash.Light" parent="android:Theme.Holo.Light.NoActionBar"/>
    <style name="FastSplash.Black" parent="android:Theme.Holo.NoActionBar"/>
</resources>
