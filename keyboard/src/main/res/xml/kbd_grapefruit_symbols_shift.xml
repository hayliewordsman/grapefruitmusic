<?xml version="1.0" ?>
<!-- Grapefruit LegacyHolo reference arrangement; original Grapefruit additions. -->
<Keyboard xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_grapefruit"/>
    <include latin:keyboardLayout="@xml/key_styles_currency"/>
    <Row latin:keyWidth="9.0909%p">
        <include latin:keyboardLayout="@xml/rowkeys_symbols_shift1"/>
        <Key latin:keyStyle="deleteKeyStyle" latin:keyWidth="fillRight"/>
    </Row>
    <Row latin:keyWidth="9.0909%p">
        <include latin:keyboardLayout="@xml/rowkeys_symbols_shift2"/>
        <Key latin:keyStyle="enterKeyStyle" latin:keyWidth="fillRight"/>
    </Row>
    <Row latin:keyWidth="9.0909%p">
        <Key latin:keyStyle="backFromMoreSymbolKeyStyle"/>
        <Key latin:keyLabel="™"/>
        <Key latin:keyLabel="®"/>
        <Key latin:keyLabel="©"/>
        <Key latin:keyLabel="¶" latin:moreKeys="§"/>
        <Key latin:keyLabel="\\"/>
        <Key latin:keyLabel="&lt;"/>
        <Key latin:keyLabel="&gt;"/>
        <Key latin:keyLabel="="/>
        <Key latin:keyLabel="_"/>
        <Key latin:keyStyle="backFromMoreSymbolKeyStyle" latin:keyWidth="fillRight"/>
    </Row>
    <include latin:keyboardLayout="@xml/row_grapefruit_bottom"/>
</Keyboard>
