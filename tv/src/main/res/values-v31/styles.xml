<resources>
    <!-- Android 12+ draws its own splash screen first: the TV grapefruit on the theme's colour. -->
    <style name="FastTheme" parent="FastBase">
        <item name="android:colorAccent">#FF7F6B</item>
        <item name="android:windowSplashScreenBackground">#1C0A0E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="FastSplash.Dark" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowSplashScreenBackground">#1C0A0E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="FastSplash.Light" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FCE4D9</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="FastSplash.Black" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
